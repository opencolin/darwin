# MongoDB Atlas (the hackathon sandbox cluster). DARWIN_MONGODB_URI wins over MONGODB_URI when both are set.
MONGODB_URI=
# LLM gateway (OpenAI-compatible). Defaults: AISA. Swap base URL + key for OpenRouter / Vercel AI Gateway.
AISA_API_KEY=
LLM_BASEURL=https://api.aisa.one/v1
DARWIN_WORKER_MODEL=claude-haiku-5-5
DARWIN_META_MODEL=claude-opus-5-5
# Voyage AI embeddings (served by MongoDB at ai.mongodb.com, or api.voyageai.com)
VOYAGE_API_KEY=
VOYAGE_ENDPOINT=ai.mongodb.com
# Raindrop observability
RAINDROP_WRITE_KEY=
# Phone write actions (decide / freeze / mode) require this when set; `darwin status` prints the operator link
DARWIN_OPERATOR_TOKEN=
DARWIN_PUBLIC_URL=http://localhost:3000
